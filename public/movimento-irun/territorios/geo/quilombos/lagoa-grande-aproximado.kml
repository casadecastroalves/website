<?xml version="1.0" encoding="UTF-8"?>
<!--
  TERRITÓRIO QUILOMBOLA DE LAGOA GRANDE — Feira de Santana, Bahia
  Fonte: Cartografia Social AQCOMAQ 2022 (leitura visual do mapa)
  Sistema: SIRGAS 2000 / WGS84 (equivalentes para uso prático)

  ATENÇÃO: Estes polígonos são APROXIMADOS, derivados da leitura visual
  do mapa publicado pela AQCOMAQ (escala 1:45.000, UTM Zona 24S).
  Para os limites exactos, solicitar o shapefile ao técnico SIG:
  BONFIM, T.O. — Assessoria Técnica SIG da AQCOMAQ.

  Sub-comunidades confirmadas (Teia dos Povos, Nov 2021):
  Carro Quebrado, Fazenda Rumo, Genipapo, Lagoa da Camisa,
  Lagoa Grande, Lagoa Suja, Várzea da Telha
-->
<kml xmlns="http://www.opengis.net/kml/2.2">
  <Document>
    <name>Território Quilombola de Lagoa Grande (aprox.)</name>
    <description>Cartografia Social AQCOMAQ 2022 — polígonos aproximados</description>

    <!-- Estilos por sub-comunidade (cores do mapa AQCOMAQ) -->
    <Style id="carro-quebrado">
      <PolyStyle><color>80d6a68b</color><outline>1</outline></PolyStyle>
      <LineStyle><color>ffd6a68b</color><width>2</width></LineStyle>
    </Style>
    <Style id="fazenda-rumo">
      <PolyStyle><color>80c8e0f0</color><outline>1</outline></PolyStyle>
      <LineStyle><color>ffc8e0f0</color><width>2</width></LineStyle>
    </Style>
    <Style id="genipapo">
      <PolyStyle><color>8068c868</color><outline>1</outline></PolyStyle>
      <LineStyle><color>ff68c868</color><width>2</width></LineStyle>
    </Style>
    <Style id="lagoa-camisa">
      <PolyStyle><color>80606060</color><outline>1</outline></PolyStyle>
      <LineStyle><color>ff606060</color><width>2</width></LineStyle>
    </Style>
    <Style id="lagoa-grande">
      <PolyStyle><color>803060d0</color><outline>1</outline></PolyStyle>
      <LineStyle><color>ff3060d0</color><width>2</width></LineStyle>
    </Style>
    <Style id="lagoa-suja">
      <PolyStyle><color>8070e0a0</color><outline>1</outline></PolyStyle>
      <LineStyle><color>ff70e0a0</color><width>2</width></LineStyle>
    </Style>
    <Style id="varzea-telha">
      <PolyStyle><color>80a060c0</color><outline>1</outline></PolyStyle>
      <LineStyle><color>ffa060c0</color><width>2</width></LineStyle>
    </Style>

    <!-- ══ SUB-COMUNIDADES ══ -->

    <Placemark>
      <name>Carro Quebrado</name>
      <description>Sub-comunidade do Território Quilombola de Lagoa Grande (Noroeste)</description>
      <styleUrl>#carro-quebrado</styleUrl>
      <Polygon>
        <outerBoundaryIs><LinearRing><coordinates>
          -39.020,-12.098,0
          -38.995,-12.098,0
          -38.995,-12.140,0
          -39.020,-12.140,0
          -39.020,-12.098,0
        </coordinates></LinearRing></outerBoundaryIs>
      </Polygon>
    </Placemark>

    <Placemark>
      <name>Fazenda Rumo</name>
      <description>Sub-comunidade do Território Quilombola de Lagoa Grande (Norte-Centro)</description>
      <styleUrl>#fazenda-rumo</styleUrl>
      <Polygon>
        <outerBoundaryIs><LinearRing><coordinates>
          -38.997,-12.095,0
          -38.975,-12.095,0
          -38.975,-12.128,0
          -38.997,-12.128,0
          -38.997,-12.095,0
        </coordinates></LinearRing></outerBoundaryIs>
      </Polygon>
    </Placemark>

    <Placemark>
      <name>Genipapo</name>
      <description>Sub-comunidade do Território Quilombola de Lagoa Grande (Leste)</description>
      <styleUrl>#genipapo</styleUrl>
      <Polygon>
        <outerBoundaryIs><LinearRing><coordinates>
          -38.978,-12.100,0
          -38.957,-12.100,0
          -38.957,-12.142,0
          -38.978,-12.142,0
          -38.978,-12.100,0
        </coordinates></LinearRing></outerBoundaryIs>
      </Polygon>
    </Placemark>

    <Placemark>
      <name>Lagoa da Camisa</name>
      <description>Sub-comunidade do Território Quilombola de Lagoa Grande (Centro-Oeste)</description>
      <styleUrl>#lagoa-camisa</styleUrl>
      <Polygon>
        <outerBoundaryIs><LinearRing><coordinates>
          -39.018,-12.120,0
          -38.991,-12.120,0
          -38.991,-12.150,0
          -39.018,-12.150,0
          -39.018,-12.120,0
        </coordinates></LinearRing></outerBoundaryIs>
      </Polygon>
    </Placemark>

    <Placemark>
      <name>Lagoa Grande</name>
      <description>Sub-comunidade central — lagoa e sede da AQCOMAQ</description>
      <styleUrl>#lagoa-grande</styleUrl>
      <Polygon>
        <outerBoundaryIs><LinearRing><coordinates>
          -39.000,-12.122,0
          -38.980,-12.122,0
          -38.980,-12.155,0
          -39.000,-12.155,0
          -39.000,-12.122,0
        </coordinates></LinearRing></outerBoundaryIs>
      </Polygon>
    </Placemark>

    <Placemark>
      <name>Lagoa Suja</name>
      <description>Sub-comunidade do Território Quilombola de Lagoa Grande (Sul)</description>
      <styleUrl>#lagoa-suja</styleUrl>
      <Polygon>
        <outerBoundaryIs><LinearRing><coordinates>
          -38.989,-12.136,0
          -38.965,-12.136,0
          -38.965,-12.160,0
          -38.989,-12.160,0
          -38.989,-12.136,0
        </coordinates></LinearRing></outerBoundaryIs>
      </Polygon>
    </Placemark>

    <Placemark>
      <name>Várzea da Telha</name>
      <description>Sub-comunidade do Território Quilombola de Lagoa Grande (Centro-Leste)</description>
      <styleUrl>#varzea-telha</styleUrl>
      <Polygon>
        <outerBoundaryIs><LinearRing><coordinates>
          -38.993,-12.111,0
          -38.970,-12.111,0
          -38.970,-12.140,0
          -38.993,-12.140,0
          -38.993,-12.111,0
        </coordinates></LinearRing></outerBoundaryIs>
      </Polygon>
    </Placemark>

  </Document>
</kml>
