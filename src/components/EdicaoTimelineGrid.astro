---
export interface TimelineItem {
  num: number | string;
  data: string;
  artista: string;
  show: string;
  desc: string;
  slug: string;
  img: string;
}

export interface Props {
  edicoes: TimelineItem[];
}

const { edicoes } = Astro.props;
---

<div class="edicoes-grid">
  {
    edicoes.map((ed) => (
      <a href={`/movimento-irun/${ed.slug}`} class="edicao-card card">
        <div class="edicao-img-wrapper">
          <img
            src={ed.img}
            alt={
              typeof ed.num === 'number'
                ? `Poster oficial da ${ed.num}ª edição do Movimento Irun`
                : `Poster oficial do Movimento Irun — ${ed.show}`
            }
            class={ed.slug === 'confraria-de-oya' ? 'img-contain' : ''}
          />
        </div>
        <div class="edicao-content">
          <span class="edicao-date">{ed.data}</span>
          <h3>{typeof ed.num === 'number' ? `Edição ${ed.num}: ` : ''}{ed.show}</h3>
          <p class="edicao-artist">{typeof ed.num === 'number' ? 'Convidado(a): ' : ''}{ed.artista}</p>
          <p class="edicao-desc">{ed.desc}</p>
          <span class="edicao-link">Ver detalhes da edição →</span>
        </div>
      </a>
    ))
  }
</div>

<style>
  .edicoes-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-xl);
    margin-top: var(--space-xl);
  }

  @media (min-width: 768px) {
    .edicoes-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .edicoes-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .edicao-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 0;
    overflow: hidden;
    background-color: var(--color-branco);
    border: 1px solid rgba(26, 26, 26, 0.08);
    border-radius: 4px;
    text-decoration: none;
    color: inherit;
    transition: transform 0.2s ease-in-out, box-shadow 0.2s ease-in-out;
  }

  .edicao-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
  }

  .edicao-img-wrapper {
    aspect-ratio: 16 / 9;
    width: 100%;
    overflow: hidden;
    background-color: var(--color-cinza-claro);
  }

  .edicao-img-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .edicao-img-wrapper img.img-contain {
    object-fit: contain;
    background-color: var(--color-branco);
    padding: var(--space-md);
  }

  .edicao-content {
    padding: var(--space-md);
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .edicao-date {
    font-size: var(--font-xs);
    font-family: var(--font-mono);
    color: var(--color-cinza-escuro);
    text-transform: uppercase;
    margin-bottom: var(--space-xs);
  }

  .edicao-content h3 {
    font-family: var(--font-serif);
    font-size: var(--font-lg);
    line-height: 1.3;
    margin-bottom: var(--space-xs);
    color: var(--color-preto-editorial);
    border: none;
    padding: 0;
  }

  .edicao-artist {
    font-size: var(--font-sm);
    font-weight: 600;
    color: var(--color-ouro);
    margin-bottom: var(--space-sm);
  }

  .edicao-desc {
    font-size: var(--font-sm);
    line-height: 1.5;
    color: var(--color-cinza-escuro);
    margin-bottom: var(--space-md);
    flex-grow: 1;
  }

  .edicao-link {
    font-size: var(--font-sm);
    font-weight: 600;
    color: var(--color-ouro);
    display: inline-block;
    transition: var(--transition-fast);
  }

  .edicao-card:hover .edicao-link {
    color: var(--color-amarelo-cca);
  }
</style>
