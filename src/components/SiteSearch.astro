---
---

<dialog class="site-search-dialog" id="siteSearchDialog" aria-label="Buscar no site">
  <div class="site-search-panel">
    <div class="site-search-header">
      <p class="site-search-label">Buscar</p>
      <button type="button" class="site-search-close" aria-label="Fechar busca" data-close-search>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
        </svg>
      </button>
    </div>

    <label class="site-search-field">
      <span class="visually-hidden">Termo de busca</span>
      <input
        type="search"
        id="siteSearchInput"
        class="site-search-input"
        placeholder="Edições, cursos, artistas…"
        autocomplete="off"
        spellcheck="false"
      />
    </label>

    <div class="site-search-results" id="siteSearchResults" aria-live="polite"></div>
    <p class="site-search-hint">Esc para fechar</p>
  </div>
</dialog>

<style>
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>

<style is:global>
  .site-search-dialog {
    position: fixed;
    inset: 0;
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0;
    padding: var(--space-lg);
    border: none;
    background: rgba(26, 26, 26, 0.52);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    z-index: 1100;
  }

  .site-search-dialog::backdrop {
    background: transparent;
  }

  .site-search-panel {
    width: min(640px, 100%);
    margin: 8vh auto 0;
    background: rgba(255, 255, 255, 0.98);
    border: 1px solid rgba(26, 26, 26, 0.1);
    padding: var(--space-lg);
  }

  .site-search-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-md);
  }

  .site-search-label {
    margin: 0;
    font-family: var(--font-interface);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-carvao);
  }

  .site-search-close {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    padding: 0;
    border: 1px solid rgba(26, 26, 26, 0.15);
    background: transparent;
    color: var(--color-preto-editorial);
    cursor: pointer;
    transition: var(--transition-fast);
  }

  .site-search-close:hover {
    border-color: var(--color-preto-editorial);
    background: rgba(26, 26, 26, 0.04);
  }

  .site-search-field {
    display: block;
  }

  .site-search-input {
    width: 100%;
    box-sizing: border-box;
    border: none;
    border-bottom: 1px solid rgba(26, 26, 26, 0.15);
    background: transparent;
    padding: var(--space-sm) 0;
    font-family: var(--font-body);
    font-size: 1.05rem;
    color: var(--color-preto-editorial);
  }

  .site-search-input:focus {
    outline: none;
    border-bottom-color: var(--color-preto-editorial);
  }

  .site-search-input::placeholder {
    color: rgba(26, 26, 26, 0.4);
  }

  .site-search-results {
    margin-top: var(--space-md);
    max-height: 50vh;
    overflow-y: auto;
  }

  .site-search-empty {
    margin: var(--space-md) 0 0;
    font-family: var(--font-body);
    font-size: 0.95rem;
    color: var(--color-carvao);
  }

  .site-search-result {
    display: block;
    padding: var(--space-md) 0;
    border-bottom: 1px solid rgba(26, 26, 26, 0.08);
    text-decoration: none;
    color: inherit;
    transition: var(--transition-fast);
  }

  .site-search-result:last-child {
    border-bottom: none;
  }

  .site-search-result:hover .site-search-result-title,
  .site-search-result:focus-visible .site-search-result-title {
    color: var(--color-ouro);
  }

  .site-search-result-meta {
    display: block;
    font-family: var(--font-interface);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(26, 26, 26, 0.45);
    margin-bottom: 4px;
  }

  .site-search-result-title {
    display: block;
    font-family: var(--font-display);
    font-size: 1.15rem;
    line-height: 1.3;
    color: var(--color-preto-editorial);
    transition: var(--transition-fast);
  }

  .site-search-result-excerpt {
    display: block;
    margin-top: 4px;
    font-family: var(--font-body);
    font-size: 0.9rem;
    line-height: 1.5;
    color: var(--color-carvao);
  }

  .site-search-hint {
    margin: var(--space-md) 0 0;
    font-family: var(--font-interface);
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: rgba(26, 26, 26, 0.45);
    text-align: right;
  }
</style>

<script>
  type SearchEntry = {
    title: string;
    url: string;
    excerpt: string;
    category: string;
  };

  const dialog = document.getElementById('siteSearchDialog') as HTMLDialogElement | null;
  const input = document.getElementById('siteSearchInput') as HTMLInputElement | null;
  const resultsEl = document.getElementById('siteSearchResults') as HTMLElement | null;

  let index: SearchEntry[] = [];
  let indexLoaded = false;

  function normalize(value: string) {
    return value
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g, '')
      .toLowerCase();
  }

  async function loadIndex() {
    if (indexLoaded) return;
    const response = await fetch('/search-index.json');
    if (!response.ok) return;
    index = await response.json();
    indexLoaded = true;
  }

  function renderResults(query: string) {
    if (!resultsEl) return;

    const trimmed = query.trim();
    if (!trimmed) {
      resultsEl.innerHTML = '<p class="site-search-empty">Digite para pesquisar páginas, edições e cursos.</p>';
      return;
    }

    const terms = normalize(trimmed).split(/\s+/).filter(Boolean);
    const matches = index
      .filter((entry) => {
        const haystack = normalize(`${entry.title} ${entry.excerpt} ${entry.category}`);
        return terms.every((term) => haystack.includes(term));
      })
      .slice(0, 12);

    if (matches.length === 0) {
      resultsEl.innerHTML = '<p class="site-search-empty">Nenhum resultado encontrado.</p>';
      return;
    }

    resultsEl.innerHTML = matches
      .map(
        (entry) => `
          <a class="site-search-result" href="${entry.url}">
            <span class="site-search-result-meta">${entry.category}</span>
            <span class="site-search-result-title">${entry.title}</span>
            <span class="site-search-result-excerpt">${entry.excerpt}</span>
          </a>
        `
      )
      .join('');
  }

  async function openSearch() {
    if (!dialog) return;
    await loadIndex();
    dialog.showModal();
    input?.focus();
    renderResults(input?.value ?? '');
  }

  function closeSearch() {
    dialog?.close();
    if (input) input.value = '';
    renderResults('');
  }

  document.querySelectorAll('[data-open-search]').forEach((button) => {
    button.addEventListener('click', openSearch);
  });

  document.querySelectorAll('[data-close-search]').forEach((button) => {
    button.addEventListener('click', closeSearch);
  });

  dialog?.addEventListener('click', (event) => {
    if (event.target === dialog) closeSearch();
  });

  dialog?.addEventListener('cancel', closeSearch);

  input?.addEventListener('input', () => {
    renderResults(input.value);
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && dialog?.open) {
      closeSearch();
    }
  });
</script>
