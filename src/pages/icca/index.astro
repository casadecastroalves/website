---
import Layout from '../../layouts/Layout.astro';
---

<Layout
  title="ICCA — Instituto Casa de Castro Alves"
  description="O Instituto Casa de Castro Alves é um espaço de cultura, regeneração e saberes ancestrais no coração do Pelourinho, Salvador."
  ogImage="/images/a_casa/voce-ja-visitou-a-gente.webp"
>

  <section class="icca-hero">
    <div class="icca-hero-bg" style="background-image: url('/images/a_casa/voce-ja-visitou-a-gente.webp');"></div>
    <div class="icca-hero-overlay"></div>
    <div class="icca-hero-content">
      <h1 class="icca-title">Instituto Casa de<br/>Castro Alves</h1>
      
      <div class="icca-cta-wrap">
        <a href="/icca/permacultura-urbana" class="icca-cta-btn">
          <span class="icca-cta-label">Curso de Permacultura Urbana</span>
          <svg class="icca-cta-arrow" width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </div>
    </div>
  </section>

</Layout>

<style>
  .icca-hero {
    position: relative;
    min-height: calc(100vh - 80px); /* Adjust for header height */
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .icca-hero-bg {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center 25%;
    background-repeat: no-repeat;
  }

  .icca-hero-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.45); /* Dark fume overlay to ensure white title stands out */
  }

  .icca-hero-content {
    position: relative;
    z-index: 2;
    text-align: center;
    padding: 2rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    max-width: 800px;
  }

  .icca-title {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    font-weight: normal;
    color: var(--color-branco);
    letter-spacing: -0.02em;
    line-height: 1.1;
    margin-bottom: var(--space-xl);
    text-transform: uppercase;
  }

  .icca-cta-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    padding: 1.25rem 2.5rem;
    background-color: var(--color-amarelo-cca);
    color: var(--color-preto-editorial);
    font-family: var(--font-interface);
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    border: none;
    cursor: pointer;
    transition: var(--transition-smooth);
    text-decoration: none;
    box-shadow: 0 4px 15px rgba(0,0,0,0.15);
  }

  .icca-cta-btn:hover {
    background-color: var(--color-branco);
    transform: translateY(-2px);
    box-shadow: 0 12px 32px rgba(0,0,0,0.25);
  }

  .icca-cta-arrow {
    transition: transform 0.25s ease;
  }

  .icca-cta-btn:hover .icca-cta-arrow {
    transform: translateX(4px);
  }
</style>
