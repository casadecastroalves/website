---
import Layout from '../../layouts/Layout.astro';
---

<Layout
  title="ICCA — Instituto Casa de Castro Alves"
  description="O Instituto Casa de Castro Alves é um espaço de cultura, regeneração e saberes ancestrais no coração do Pelourinho, Salvador."
  ogImage="/images/a_casa/voce-ja-visitou-a-gente.webp"
>

  <section class="icca-hero">
    <div class="icca-hero-bg" style="background-image: url('/images/a_casa/voce-ja-visitou-a-gente.webp');"></div>
    <div class="icca-hero-overlay"></div>
    <div class="icca-hero-content">
      <h1 class="icca-title">Instituto Casa de<br/>Castro Alves</h1>
    </div>
  </section>

</Layout>

<style>
  .icca-hero {
    position: relative;
    min-height: calc(100vh - 80px); /* Adjust for header height */
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .icca-hero-bg {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center 25%;
    background-repeat: no-repeat;
  }

  .icca-hero-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.45); /* Dark fume overlay to ensure white title stands out */
  }

  .icca-hero-content {
    position: relative;
    z-index: 2;
    text-align: center;
    padding: 2rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    max-width: 800px;
  }

  .icca-title {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    font-weight: normal;
    color: var(--color-branco);
    letter-spacing: -0.02em;
    line-height: 1.1;
    margin: 0;
    text-transform: uppercase;
  }
</style>
