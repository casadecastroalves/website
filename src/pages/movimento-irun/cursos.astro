---
import Layout from '../../layouts/Layout.astro';
import { cursosPage, statusClass } from '../../data/cursosData.js';

const {
  hero,
  programaBemViver,
  eixosTitulo,
  eixosSubtitulo,
  eixos,
  oficinasTitulo,
  oficinasSubtitulo,
  oficinas,
  cronograma,
  apoio,
} = cursosPage;
---

<Layout title="Cursos e Formações | Movimento Irun" description="Ciclo Formativo do Movimento Irun na Casa de Castro Alves. Formações em Permacultura Urbana, Cidade Cidadã e o Programa Bem Viver. Inscrições e calendário." ogImage={hero.imagem}>
  <section class="subpage-hero">
    <div class="subpage-hero-bg" style={`background-image: url('${hero.imagem}');`}></div>
    <div class="subpage-hero-overlay"></div>
    <div class="container subpage-hero-content">
      <h1 class="subpage-hero-title">{hero.titulo}</h1>
      <p class="subpage-hero-subtitle">{hero.subtitulo}</p>
      <div style="margin-top: 2rem;">
        <a href={hero.inscricaoUrl} target="_blank" rel="noopener noreferrer" class="btn btn-outline-amarelo">
          INSCREVA-SE
        </a>
      </div>
    </div>
  </section>

  <section class="bem-viver-section">
    <div class="container">
      <span class="section-badge">{programaBemViver.badge}</span>
      <h2>{programaBemViver.titulo}</h2>
      {programaBemViver.paragrafos.map((p, i) => (
        <p class:list={[{ 'lead-text': i === 0 }]}>{p}</p>
      ))}
    </div>
  </section>

  <section class="eixos-section">
    <div class="container">
      <div class="section-header text-center">
        <span class="section-badge">Cursos</span>
        <h2>{eixosTitulo}</h2>
        <p class="section-subtitle">{eixosSubtitulo}</p>
      </div>

      <div class="eixos-grid">
        {eixos.map((eixo) => (
          <div class="eixo-card card">
            <span class="eixo-number">{eixo.numero}</span>
            <div class="eixo-header">
              <h3 set:html={eixo.titulo.replace(/\n/g, '<br />')} />
            </div>
            <p class="eixo-instructor">Facilitadora: {eixo.facilitador}</p>
            {eixo.metodologia && <p class="eixo-subtitle-detail">{eixo.metodologia}</p>}
            <ul class="eixo-topics">
              {eixo.topicos.map((item) => <li>{item}</li>)}
            </ul>
          </div>
        ))}
      </div>

      <div class="eixos-footer">
        <a href={hero.inscricaoUrl} target="_blank" rel="noopener noreferrer" class="btn btn-primary">
          INSCREVA-SE
        </a>
      </div>
    </div>
  </section>

  <section class="formacoes-historicas">
    <div class="container">
      <div class="section-header text-center">
        <span class="section-badge">Oficinas e Extensões</span>
        <h2>{oficinasTitulo}</h2>
        <p class="section-subtitle">{oficinasSubtitulo}</p>
      </div>

      <div class="courses-box-grid">
        {oficinas.map((curso) => (
          <div
            class="course-box card"
            style={curso.larguraCompleta ? 'grid-column: 1 / -1;' : undefined}
          >
            {curso.larguraCompleta && curso.imagens?.length ? (
              <div class="csu-course-container">
                <div class="csu-text-content">
                  <div class="course-header">
                    <h3>{curso.titulo}</h3>
                    <span class="time-badge">{curso.badge}</span>
                  </div>
                  <p class="course-instructor">{curso.facilitador}</p>
                  <p>{curso.descricao}</p>
                  <div class="course-footer">
                    {curso.url ? (
                      <a href={curso.url} class={`status-badge ${statusClass(curso.status)}`}>{curso.status}</a>
                    ) : (
                      <span class={`status-badge ${statusClass(curso.status)}`}>{curso.status}</span>
                    )}
                  </div>
                </div>
                <div class="csu-gallery-content">
                  {curso.galeriaTitulo && <p class="gallery-title">{curso.galeriaTitulo}</p>}
                  <div class="csu-gallery-grid" style="grid-template-columns: repeat(2, 1fr);">
                    {curso.imagens.map((img) => (
                      <div class="csu-gallery-item shadow-premium">
                        <img src={img.src} alt={img.alt} />
                      </div>
                    ))}
                  </div>
                </div>
              </div>
            ) : (
              <>
                <div>
                  <div class="course-header">
                    <h3>{curso.titulo}</h3>
                    <span class="time-badge">{curso.badge}</span>
                  </div>
                  <p class="course-instructor">{curso.facilitador}</p>
                  <p>{curso.descricao}</p>
                </div>
                <div class="course-footer">
                  {curso.url ? (
                    <a href={curso.url} class={`status-badge ${statusClass(curso.status)}`}>{curso.status}</a>
                  ) : (
                    <span class={`status-badge ${statusClass(curso.status)}`}>{curso.status}</span>
                  )}
                </div>
              </>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="calendario-section">
    <div class="container">
      <div class="calendario-card">
        <div class="calendario-info">
          <h2>{cronograma.titulo}</h2>
          <p set:html={cronograma.intro.replace(/(19 de julho de 2025)/, '<strong>$1</strong>')} />
          <div class="ciclos-list">
            {cronograma.ciclos.map((ciclo) => (
              <div class="ciclo-item">
                <strong>{ciclo.label}</strong> {ciclo.periodo}
              </div>
            ))}
          </div>
        </div>
        <div class="calendario-status text-center">
          <div class="lock-icon" style="color: var(--color-ouro); margin-bottom: var(--space-sm);">
            <svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display: inline-block;"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
          </div>
          <h3>{cronograma.statusTitulo}</h3>
          <p>{cronograma.statusTexto}</p>
          <a href="/contato" class="btn btn-dark">Fale Conosco</a>
        </div>
      </div>
    </div>
  </section>

  <section class="apoio-section">
    <div class="container text-center">
      <h3>{apoio.titulo}</h3>
      <p class="apoio-text">{apoio.texto}</p>
      <div class="apoio-banner-wrapper">
        <img src={apoio.banner} alt={apoio.bannerAlt} class="apoio-banner-img" />
      </div>
    </div>
  </section>
</Layout>
<style>
  /* Grid layout for intro */
  .bem-viver-section {
    background-color: var(--color-creme);
  }

  .lead-text {
    font-size: 1.2rem;
    line-height: 1.6;
    color: var(--color-preto-editorial);
    margin-bottom: var(--space-md);
  }



  /* Eixos structure */
  .eixos-section {
    background-color: var(--color-branco);
    border-top: 1px solid rgba(26, 26, 26, 0.05);
    border-bottom: 1px solid rgba(26, 26, 26, 0.05);
  }

  .eixos-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-xl);
    margin-top: var(--space-xl);
  }

  @media (min-width: 768px) {
    .eixos-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .eixo-card {
    position: relative;
    padding: var(--space-lg);
    padding-top: 56px; /* Aumentado para dar mais respira├º├úo em rela├º├úo ao n├║mero */
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .eixo-number {
    position: absolute;
    top: var(--space-md);
    right: var(--space-lg);
    font-size: 2.5rem;
    font-family: var(--font-display);
    color: rgba(135, 103, 0, 0.5);
    font-weight: bold;
    line-height: 1;
  }

  .eixo-header {
    height: 64px; /* Altura fixa para alinhar os nomes dos facilitadores abaixo dos t├¡tulos */
    display: flex;
    align-items: flex-start;
    margin-bottom: 12px;
  }

  .eixo-card h3 {
    font-size: 1.35rem;
    margin: 0;
    border: none;
    padding: 0;
    line-height: 1.3;
  }

  .eixo-instructor {
    display: block;
    font-family: var(--font-interface);
    font-size: 0.8rem;
    color: var(--color-ouro); /* Texto dourado, sem background (design limpo e premium) */
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: bold;
    margin-bottom: 12px;
  }

  .eixo-subtitle-detail {
    font-size: 0.85rem;
    color: var(--color-carvao);
    margin-bottom: 16px;
    font-style: italic;
  }

  .eixo-topics {
    list-style-type: none;
    margin-top: 0; /* Remove o margin-top auto para manter o espa├ºo em branco na base do card */
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    padding-top: var(--space-sm);
  }

  .eixo-topics li {
    font-size: 0.95rem;
    position: relative;
    padding-left: var(--space-md);
    line-height: 1.4;
  }

  .eixo-topics li::before {
    content: "\2022";
    color: var(--color-ouro);
    font-weight: bold;
    position: absolute;
    left: 0;
    top: 0;
  }

  /* Forma├º├Áes 2025 */
  .formacoes-historicas {
    background-color: var(--color-creme);
  }

  .courses-box-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-xl);
    margin-top: var(--space-xl);
  }

  @media (min-width: 768px) {
    .courses-box-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 992px) {
    .courses-box-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .course-box {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    height: 100%;
  }

  .course-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--space-sm);
    margin-bottom: var(--space-md);
  }

  .course-header h3 {
    font-size: 1.4rem;
    margin: 0;
    border: none;
    padding: 0;
    line-height: 1.3;
  }

  .course-instructor {
    display: block;
    font-family: var(--font-interface);
    font-size: 0.8rem;
    color: var(--color-ouro);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: bold;
    margin-bottom: var(--space-md);
    margin-top: -8px;
  }

  .time-badge {
    background-color: var(--color-amarelo-cca);
    color: var(--color-preto-editorial);
    padding: 2px 8px;
    font-family: var(--font-interface);
    font-size: 0.75rem;
    font-weight: bold;
    white-space: nowrap;
    border-radius: 2px;
  }

  .course-box p {
    font-size: 0.95rem;
    color: var(--color-carvao);
    flex-grow: 1;
    margin-bottom: var(--space-lg);
    line-height: 1.5;
  }

  .status-badge {
    display: inline-block;
    font-family: var(--font-interface);
    font-size: 0.8rem;
    font-weight: bold;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 4px 12px;
    border-radius: 2px;
    border: 1px solid transparent;
  }

  .status-badge.closed {
    border: 1px solid #c9302c;
    color: #c9302c;
    background-color: rgba(201, 48, 44, 0.05);
  }

  .status-badge.finished {
    border: 1px solid var(--color-ouro);
    color: var(--color-ouro);
    background-color: rgba(135, 103, 0, 0.05);
  }

  a.status-badge {
    text-decoration: none;
    transition: var(--transition-smooth);
  }

  a.status-badge:hover {
    cursor: pointer;
  }

  a.status-badge.finished:hover {
    background-color: var(--color-ouro);
    color: var(--color-branco);
  }

  /* Gallery within cards */
  .course-gallery {
    display: flex;
    gap: var(--space-sm);
    margin-top: var(--space-sm);
    margin-bottom: var(--space-md);
  }

  .course-thumb {
    width: 70px;
    height: auto;
    object-fit: contain;
    border: 1px solid rgba(26, 26, 26, 0.08);
    background-color: var(--color-branco);
    padding: 2px;
    border-radius: 1px;
  }

  /* CSU Specific horizontal container */
  .csu-course-container {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-xl);
  }

  @media (min-width: 992px) {
    .csu-course-container {
      grid-template-columns: 1.2fr 0.8fr;
    }
  }

  .csu-text-content {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    height: 100%;
  }

  .csu-gallery-content {
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
  }

  .gallery-title {
    font-family: var(--font-interface);
    font-size: 0.85rem;
    font-weight: bold;
    margin-top: 0;
    margin-bottom: var(--space-sm);
    color: var(--color-preto-editorial);
  }

  .csu-gallery-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-sm);
  }

  .csu-gallery-item {
    background-color: var(--color-branco);
    padding: 4px;
    border: 1px solid rgba(26, 26, 26, 0.08);
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 1px;
  }

  .csu-gallery-item img {
    width: 100%;
    height: auto;
    display: block;
    object-fit: contain;
  }

  /* Calend├írio card */
  .calendario-card {
    background-color: var(--color-branco);
    border: 1px solid rgba(26, 26, 26, 0.08);
    display: grid;
    grid-template-columns: 1fr;
    box-shadow: 0 10px 30px rgba(26, 26, 26, 0.03);
  }

  @media (min-width: 992px) {
    .calendario-card {
      grid-template-columns: 1.2fr 0.8fr;
    }
  }

  .calendario-info {
    padding: var(--space-xl);
  }

  .calendario-info h2 {
    font-size: 2rem;
    margin-top: 0;
    border: none;
    padding: 0;
  }

  .ciclos-list {
    margin-top: var(--space-lg);
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-sm);
  }

  @media (min-width: 576px) {
    .ciclos-list {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .ciclo-item {
    font-family: var(--font-interface);
    font-size: 0.9rem;
    background-color: var(--color-cinza-claro);
    padding: var(--space-sm) var(--space-md);
    border-left: 2px solid var(--color-amarelo-cca);
  }

  .ciclo-item strong {
    display: block;
    font-family: var(--font-interface);
    color: var(--color-preto-editorial);
  }

  .calendario-status {
    background-color: var(--color-cinza-claro);
    padding: var(--space-xl);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    border-top: 1px solid rgba(26, 26, 26, 0.05);
  }

  @media (min-width: 992px) {
    .calendario-status {
      border-top: none;
      border-left: 1px solid rgba(26, 26, 26, 0.05);
    }
  }

  .lock-icon {
    font-size: 2.5rem;
    margin-bottom: var(--space-sm);
    line-height: 1;
  }

  .calendario-status h3 {
    font-size: 1.25rem;
    margin-bottom: var(--space-sm);
    border: none;
    padding: 0;
  }

  .calendario-status p {
    font-size: 0.85rem;
    color: var(--color-carvao);
    margin-bottom: var(--space-lg);
    max-width: 250px;
  }

  /* Apoio Section */
  .apoio-section {
    background-color: var(--color-branco);
    border-top: 1px solid rgba(26, 26, 26, 0.05);
    padding: var(--space-xl) 0;
  }

  .apoio-text {
    font-size: 0.95rem;
    color: var(--color-carvao);
    max-width: 800px;
    margin: 0 auto var(--space-xl) auto;
    line-height: 1.6;
  }

  .apoio-banner-wrapper {
    max-width: 850px;
    margin: 0 auto;
    background-color: var(--color-cinza-claro);
    padding: var(--space-sm);
    border: 1px solid rgba(26, 26, 26, 0.05);
  }

  .apoio-banner-img {
    width: 100%;
    height: auto;
    display: block;
  }

  /* Outline yellow button for hero overlays */
  .btn-outline-amarelo {
    border-color: var(--color-amarelo-cca);
    color: var(--color-amarelo-cca);
    background-color: transparent;
  }
  .btn-outline-amarelo:hover {
    background-color: var(--color-amarelo-cca);
    color: var(--color-preto-editorial);
    border-color: var(--color-amarelo-cca);
  }

  .eixos-footer {
    margin-top: var(--space-xl);
    display: flex;
    justify-content: center;
  }

  /* Lightbox styles */
  .lightbox {
    display: none;
    position: fixed;
    z-index: 9999;
    padding-top: 5vh;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    overflow: auto;
    background-color: rgba(0,0,0,0.9);
    backdrop-filter: blur(5px);
    -webkit-backdrop-filter: blur(5px);
  }
  .lightbox-content {
    margin: auto;
    display: block;
    max-width: 90%;
    max-height: 80vh;
    object-fit: contain;
    animation-name: zoom;
    animation-duration: 0.3s;
  }
  @keyframes zoom {
    from {transform:scale(0)} 
    to {transform:scale(1)}
  }
  .lightbox-close {
    position: absolute;
    top: 15px;
    right: 35px;
    color: #f1f1f1;
    font-size: 40px;
    font-weight: bold;
    transition: 0.3s;
    cursor: pointer;
  }
  .lightbox-close:hover,
  .lightbox-close:focus {
    color: var(--color-amarelo-cca);
    text-decoration: none;
    cursor: pointer;
  }
  #lightboxCaption {
    margin: auto;
    display: block;
    width: 80%;
    max-width: 700px;
    text-align: center;
    color: #ccc;
    padding: 15px 0;
    font-family: var(--font-interface);
  }
  :global(.clickable-image) {
    cursor: zoom-in;
    transition: opacity 0.3s ease, transform 0.3s ease;
  }
  :global(.clickable-image:hover) {
    opacity: 0.8;
    transform: scale(1.02);
  }
</style>

<!-- Lightbox Markup -->
<div id="imageLightbox" class="lightbox">
  <span class="lightbox-close">&times;</span>
  <img class="lightbox-content" id="lightboxImg" alt="Imagem ampliada">
  <div id="lightboxCaption"></div>
</div>

<script is:inline>
  document.addEventListener('DOMContentLoaded', function() {
    const lightbox = document.getElementById('imageLightbox');
    const lightboxImg = document.getElementById('lightboxImg');
    const captionText = document.getElementById('lightboxCaption');
    const closeBtn = document.getElementsByClassName('lightbox-close')[0];
    
    // Add click to all gallery images
    const images = document.querySelectorAll('.csu-gallery-item img, .course-gallery img');
    images.forEach(img => {
      img.classList.add('clickable-image');
      img.onclick = function() {
        lightbox.style.display = 'block';
        lightboxImg.src = this.src;
        captionText.innerHTML = this.alt;
      }
    });

    if (closeBtn) {
      closeBtn.onclick = function() { 
        lightbox.style.display = 'none';
      }
    }

    // Close when clicking outside
    if (lightbox) {
      lightbox.onclick = function(e) {
        if (e.target !== lightboxImg) {
          lightbox.style.display = 'none';
        }
      }
    }
  });
</script>

