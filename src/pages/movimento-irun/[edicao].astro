    box-shadow: 0 15px 35px rgba(26, 26, 26, 0.06);
  }

  .card-highlight-label {
    display: inline-block;
    background-color: var(--color-preto-editorial);
    color: var(--color-amarelo-cca);
    padding: 6px 12px;
    font-family: var(--font-interface);
    font-size: 0.75rem;
    font-weight: bold;
    text-transform: uppercase;
    letter-spacing: 0.1em;
