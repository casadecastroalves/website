    border-radius: 2px;
  }

  /* Video Section */
  .video-section {
    background-color: var(--color-branco);
    border-top: 1px solid rgba(26, 26, 26, 0.05);
    padding: var(--space-xl) 0;
  }

  .video-iframe-wrapper {
    background-color: var(--color-branco);
    padding: var(--space-sm);
    border: 1px solid rgba(26, 26, 26, 0.08);
    max-width: 900px;
    margin: var(--space-xl) auto 0 auto;
    border-radius: 4px;
  }

  .video-iframe-wrapper iframe {
    display: block;
    border-radius: 2px;
  }

/* Carousel CSS now handled by CarouselEdicoes component */

  /* Edition Slideshow Styles */
  .edition-slideshow {
    position: relative;
    background-color: var(--color-branco);
    padding: var(--space-sm);
    border: 1px solid rgba(26, 26, 26, 0.08);
    border-radius: 4px;
    overflow: hidden;
  }

  .edition-slideshow-track-wrapper {
    overflow: hidden;
    position: relative;
    width: 100%;
  }

  .edition-slideshow-track {
    display: flex;
    transition: transform 0.4s cubic-bezier(0.25, 1, 0.5, 1);
    width: 100%;
  }

  .edition-slide {
    flex: 0 0 100%;
    width: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .edicao-poster-img-contain {
    width: 100%;
    height: auto;
    max-height: 650px;
    object-fit: contain;
    display: block;
  }

  /* Edition Navigation Buttons */
  .edition-nav-btn {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background-color: rgba(26, 26, 26, 0.8);
    color: var(--color-amarelo-cca);
    border: none;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    display: flex;
    justify-content: center;
    align-items: center;
