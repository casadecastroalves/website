---
import Layout from '../../layouts/Layout.astro';
import EdicaoTimelineGrid from '../../components/EdicaoTimelineGrid.astro';
import { edicoesTimeline } from '../../data/edicoesTimeline.js';
---

<Layout title="Edições do Movimento Irun | Casa de Castro Alves" description="Confira o registro histórico de todas as edições do Movimento Irun na Casa de Castro Alves." ogImage="/images/movimento_irun/TAMANDUA-TUPINAMBA-FOTO-LUCIANO-PAYAYA-BX.jpg">
  <!-- Hero Section -->
  <section class="subpage-hero">
    <div class="subpage-hero-bg" style="background-image: url('/images/movimento_irun/TAMANDUA-TUPINAMBA-FOTO-LUCIANO-PAYAYA-BX.jpg');"></div>
    <div class="subpage-hero-overlay"></div>
    
    <!-- Header Navigation Arrows -->
    <a href="/movimento-irun" class="nav-arrow left-arrow" aria-label="Voltar para Movimento Irun">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
    </a>
    <a href="/movimento-irun/edicao-1" class="nav-arrow right-arrow" aria-label="Ir para a Primeira Edição">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
    </a>

    <span class="header-credit">TAMANDUA TUPINAMBA por LUCIANO PAYAYÁ</span>
  </section>

  <!-- Edições Grid (Full 12 grid in 3 columns) -->
  <section class="edicoes-grid-section">
    <div class="container">
      <div class="section-header text-center">
        <span class="section-badge">Registro Histórico</span>
        <h2>Linha do Tempo das Edições</h2>
        <p class="section-subtitle">Movimento Irun 2025 e 2026</p>
      </div>

      <EdicaoTimelineGrid edicoes={edicoesTimeline} />
    </div>
  </section>

  <!-- Apoios e Logos Rodapé -->
  <section class="apoio-section">
    <div class="container text-center">
      <h3>Apoio e Fomento</h3>
      <p class="apoio-text">
        Este projeto foi contemplado nos Editais da Política Nacional Aldir Blanc Bahia e tem apoio financeiro do Governo do Estado da Bahia, por meio da Secretaria de Cultura do Estado via PNAB, direcionada pelo Ministério da Cultura - Governo Federal. A iniciativa é também contemplada pela Política Nacional Cultura Viva.
      </p>
      <div class="apoio-banner-wrapper">
        <img src="/REGUAS_PNAB_BA_CULTURA_VIVA.png" alt="Logos de apoio do Movimento Irun - Secult-BA, PNAB, Governo da Bahia, Ministério da Cultura, Cultura Viva" class="apoio-banner-img" />
      </div>
    </div>
  </section>
</Layout>

<style>
  /* Button styles */
  .btn-outline-amarelo {
    border-color: var(--color-amarelo-cca);
    color: var(--color-amarelo-cca);
    background-color: transparent;
  }
  .btn-outline-amarelo:hover {
    background-color: var(--color-amarelo-cca);
    color: var(--color-preto-editorial);
    border-color: var(--color-amarelo-cca);
  }

  /* Nav Arrows for Hero */
  .subpage-hero {
    position: relative;
  }
  .nav-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 50px;
    height: 50px;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: rgba(255, 255, 255, 0.1);
    color: white;
    border-radius: 50%;
    text-decoration: none;
    transition: all 0.3s ease;
    z-index: 20;
    backdrop-filter: blur(4px);
    border: 1px solid rgba(255, 255, 255, 0.2);
  }
  .nav-arrow:hover {
    background-color: var(--color-amarelo-cca);
    color: var(--color-preto-editorial);
    border-color: var(--color-amarelo-cca);
    transform: translateY(-50%) scale(1.1);
  }
  .left-arrow {
    left: var(--space-xl);
  }
  .right-arrow {
    right: var(--space-xl);
  }
  @media (max-width: 768px) {
    .nav-arrow {
      width: 40px;
      height: 40px;
    }
    .left-arrow { left: var(--space-sm); }
    .right-arrow { right: var(--space-sm); }
  }

  /* Grid styles scoped to this page */
  .edicoes-grid-section {
    background-color: var(--color-creme);
    padding: var(--space-2xl) 0;
  }

  /* Support Section scoped */
  .apoio-section {
    background-color: var(--color-branco);
    padding: var(--space-xl) 0;
    border-top: 1px solid rgba(26, 26, 26, 0.05);
  }

  .apoio-text {
    max-width: 800px;
    margin: 0 auto var(--space-lg);
    font-size: var(--font-sm);
    line-height: 1.6;
    color: var(--color-cinza-escuro);
  }

  .apoio-banner-wrapper {
    max-width: 1000px;
    margin: 0 auto;
  }

  .apoio-banner-img {
    width: 100%;
    height: auto;
    object-fit: contain;
  }

  /* Posicionamento do crédito da fotografia */
  .header-credit {
    position: absolute;
    bottom: var(--space-md);
    right: var(--space-lg);
    font-family: var(--font-interface);
    font-size: 0.7rem;
    font-weight: bold;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: rgba(255, 255, 255, 0.65);
    z-index: 10;
  }

  @media (max-width: 768px) {
    .header-credit {
      right: var(--space-md);
      font-size: 0.65rem;
    }
  }
</style>
